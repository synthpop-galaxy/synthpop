{
    "name" : "halo",

    "imf_func_kwargs" : {
        "name" : "PiecewisePowerlaw",
        "min_mass": 0.01,
        "max_mass": 100,
        "alphas" : [0.6, 0.25, 1.3, 2.3],
        "splitpoints": [0.05, 0.22, 0.55]
    },
    
    "age_func_kwargs" : {
        "name" : "single_value",
        "#comment" : "units in gigayears",
        "age_value" : 14.0
    },

    "metallicity_func_kwargs" : {
        "name" : "gaussian",
        "mean" : -1.78,
        "std" : 0.50
    },

    "kinematics_func_kwargs" : {
        "name" : "velocity_gradient",
        "sigma_u" : 131.0,
        "sigma_v" : 106.0,
        "sigma_w" : 85.0,
        "const_V_ad": 226
    }, 

    "population_density_kwargs" : {
        "name" : "Besancon2003Halo"
    }
}

